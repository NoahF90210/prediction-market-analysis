{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastaudit.dev/schemas/analysis-contract.schema.json",
  "title": "Provenance-complete Prediction Market Analysis Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "build_id", "platform", "market_id", "event_id", "event_group_id", "series_id",
    "title", "rules", "market_url", "raw_market_type", "raw_category", "normalized_category",
    "contract_role", "is_complement", "is_multileg", "is_conditional", "event_weight",
    "opened_at", "scheduled_close_at", "trading_closed_at", "event_started_at", "resolved_at",
    "forecast_boundary_at", "forecast_target_at", "forecast_observed_at", "snapshot_staleness_seconds",
    "yes_probability", "price_source", "raw_yes_orientation", "resolution", "resolution_source",
    "cutoff_volume", "final_volume", "volume_unit", "cutoff_volume_source", "final_volume_source",
    "raw_market_response_path", "raw_market_sha256", "raw_history_response_path", "raw_history_sha256",
    "retrieval_timestamp", "endpoint", "request_params", "collector_commit", "inclusion_status",
    "exclusion_reasons", "feature_columns"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "build_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "platform": {"const": "polymarket"},
    "market_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_group_id": {"type": "string", "minLength": 1},
    "series_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "rules": {"type": ["string", "null"]},
    "market_url": {"type": ["string", "null"]},
    "raw_market_type": {"type": ["string", "null"]},
    "raw_category": {"type": ["string", "null"]},
    "normalized_category": {"type": "string", "minLength": 1},
    "contract_role": {"enum": ["primary", "complement", "mutually_exclusive_member", "related_member", "standalone", "unknown"]},
    "is_complement": {"type": "boolean"},
    "is_multileg": {"type": "boolean"},
    "is_conditional": {"type": "boolean"},
    "event_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "opened_at": {"type": ["string", "null"], "format": "date-time"},
    "scheduled_close_at": {"type": ["string", "null"], "format": "date-time"},
    "trading_closed_at": {"type": ["string", "null"], "format": "date-time"},
    "event_started_at": {"type": ["string", "null"], "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "forecast_boundary_at": {"type": ["string", "null"], "format": "date-time"},
    "forecast_target_at": {"type": ["string", "null"], "format": "date-time"},
    "forecast_observed_at": {"type": ["string", "null"], "format": "date-time"},
    "snapshot_staleness_seconds": {"type": ["number", "null"], "minimum": 0},
    "yes_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "price_source": {"type": ["string", "null"]},
    "raw_yes_orientation": {"type": ["string", "null"]},
    "resolution": {"enum": ["YES", "NO", null]},
    "resolution_source": {"type": ["string", "null"]},
    "cutoff_volume": {"type": ["number", "null"], "minimum": 0},
    "final_volume": {"type": ["number", "null"], "minimum": 0},
    "volume_unit": {"type": ["string", "null"]},
    "cutoff_volume_source": {"type": ["string", "null"]},
    "final_volume_source": {"type": ["string", "null"]},
    "raw_market_response_path": {"type": ["string", "null"]},
    "raw_market_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "raw_history_response_path": {"type": ["string", "null"]},
    "raw_history_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "retrieval_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "endpoint": {"type": ["string", "null"]},
    "request_params": {"type": "object"},
    "collector_commit": {"type": ["string", "null"]},
    "inclusion_status": {"enum": ["included", "excluded"]},
    "exclusion_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "outside_observation_window", "missing_platform_identity", "missing_market_identity",
          "missing_event_identity", "non_binary_contract", "excluded_multileg_parlay",
          "excluded_conditional_contract", "missing_resolution", "missing_resolution_timestamp",
          "missing_forecast_boundary", "missing_forecast_target", "missing_snapshot_timestamp",
          "snapshot_after_cutoff", "snapshot_too_stale", "missing_forecast_probability",
          "invalid_forecast_probability", "metadata_or_terminal_snapshot", "missing_raw_market_provenance",
          "missing_raw_history_provenance", "raw_hash_mismatch", "duplicate_market_id",
          "duplicate_contract_definition", "post_cutoff_feature", "complement_relationship_unresolved"
        ]
      }
    },
    "feature_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
